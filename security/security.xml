<odoo>
    <record id="rule_ff_pos_printer_profile_company" model="ir.rule">
        <field name="name">POS printer profiles by company</field>
        <field name="model_id" ref="model_ff_pos_printer_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
</odoo>
